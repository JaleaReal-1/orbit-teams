[Unit]
Description=Orbit Joy FastAPI
After=network.target mysql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/orbitjoy/backend
ExecStart=/home/ubuntu/orbitjoy/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
